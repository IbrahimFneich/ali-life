{"files":["audio/n/00.mp3","audio/n/01.mp3","audio/n/02.mp3","audio/n/03.mp3","audio/n/04.mp3","audio/n/05.mp3","audio/n/06.mp3","audio/n/07.mp3","audio/n/08.mp3","audio/n/09.mp3","audio/n/10.mp3","audio/n/11.mp3","audio/n/12.mp3","audio/n/13.mp3","audio/n/14.mp3","audio/n/15.mp3","audio/n/16.mp3","audio/n/17.mp3","audio/n/18.mp3","audio/n/19.mp3","audio/n/20.mp3","audio/n/21.mp3","audio/n/22.mp3","audio/n/23.mp3","audio/n/24.mp3","audio/n/25.mp3","audio/n/26.mp3","audio/n/27.mp3","audio/n/28.mp3","audio/n/29.mp3","audio/n/30.mp3","audio/n/31.mp3","audio/n/32.mp3","audio/n/33.mp3","audio/n/34.mp3","audio/n/35.mp3","audio/n/36.mp3","audio/n/37.mp3","audio/n/38.mp3","audio/n/39.mp3","audio/n/40.mp3","audio/n/41.mp3","audio/n/42.mp3","audio/n/43.mp3"],"k":{"سيرة أمير المؤمنينمن مصادر الإمامية":{"s":[0,0.0,5.112]},"عليابن أبي طالب عليه السلام":{"s":[0,5.462,3.72]},"ولد في جوف الكعبة":{"s":[0,9.532,2.856]},"واستشهد في محراب الكوفة":{"s":[0,12.738,3.264]},"تمهيد":{"s":[0,16.352,1.872]},"هذه سيرة علي بن أبي طالب عليه السلام كما ترويها كتب الإمامية: نهج البلاغة الذي جمع فيه الشريف الرضي كلامه، والإرشاد للشيخ المفيد، والكافي، وأمالي الصدوق، ووقعة صفين، وغيرها. ولد في بيت الله، ونشأ في حجر رسول الله، وقاتل بين يديه، وصبر بعده، وحكم بالعدل، واستشهد في محراب الصلاة. مرر الصفحة كما تمر السنون؛ والعداد في أعلى الشاشة يحسب عمره.":{"s":[0,18.574,37.152]},"سنة عاشها، من رجب سنة من عام الفيل إلى رمضان سنة ه":{"s":[0,56.076,13.296]},"سنة وأشهرا بعد رسول الله صلى الله عليه وآله «ممنوعا من التصرف على أحكامها» (الإرشاد :)":{"s":[0,69.722,9.552]},"حروب في خلافته: الجمل وصفين والنهروان":{"s":[0,79.624,5.64]},"نص في نهج البلاغة: خطبة و كتابا و حكمة":{"s":[0,85.614,11.4]},"رجب، سنة من عام الفيلمكة":{"s":[1,0.0,6.288]},"الولادة في الكعبة":{"s":[1,6.638,2.784]},"مكة، عند البيت الحرام":{"s":[1,9.772,3.384]},"أقبلت فاطمة بنت أسد إلى البيت الحرام وقد أخذها الطلق، فدعت ربها عند جدار الكعبة. يروي يزيد بن قعنب:":{"s":[1,13.506,11.232]},"«فرأينا البيت وقد انفتح عن ظهره، ودخلت فاطمة فيه، وغابت عن أبصارنا، والتزق الحائط»":{"s":[1,25.088,9.24]},"في جوف الكعبة":{"s":[1,34.678,2.472]},"«فرمنا أن ينفتح لنا قفل الباب فلم ينفتح، فعلمنا أن ذلك أمر من أمر الله عز وجل»":{"s":[1,37.5,8.232]},"«ثم خرجت بعد الرابع وبيدها أمير المؤمنين عليه السلام»":{"s":[1,46.082,5.688]},"لم يولد قبله ولا بعده مولود في بيت الله تعالى سواه، إكراما من الله تعالى له بذلك، وإجلالا لمحله في التعظيم.":{"s":[1,52.12,11.304]},"هو علي بن أبي طالب بن عبد المطلب بن هاشم بن عبد مناف. وأبو طالب عم رسول الله صلى الله عليه وآله وكافله، واسمه عبد مناف، يقول علي عليه السلام: «إن اسم أبي عبد مناف، فغلبت الكنية على الاسم».":{"s":[1,63.774,20.136]},"وأمه فاطمة بنت أسد بن هاشم بن عبد مناف، «وهو أول هاشمي ولده هاشم مرتين».":{"s":[1,84.26,8.64]},"ولد بمكة في البيت الحرام يوم الجمعة الثالث عشر من رجب، سنة ثلاثين من عام الفيل.":{"s":[2,0.0,8.136]},"كنيته أبو الحسن، وكناه رسول الله صلى الله عليه وآله أبا تراب، قال ابن عباس: «لأنه صاحب الأرض، وحجة الله على أهلها بعده». وسمته أمه حيدرة، كما قال في رجزه يوم خيبر.":{"s":[2,8.486,19.224]},"طفولتهمكة":{"s":[2,28.06,2.88]},"في حجر رسول الله":{"s":[2,31.29,2.616]},"نهج البلاغة، الخطبة (القاصعة)":{"s":[2,34.256,6.72]},"وضعني في حجره وأنا ولد، يضمني إلى صدره، ويكنفني في فراشه، ويمسني جسده، ويشمني عرفه":{"s":[2,41.326,10.392]},"ولقد كنت أتبعه اتباع الفصيل أثر أمه، يرفع لي في كل يوم من أخلاقه علما، ويأمرني بالاقتداء به":{"s":[2,52.068,9.864]},"ضمه رسول الله صلى الله عليه وآله إليه وهو صغير، فنشأ في بيته، ورأى أخلاقه كل يوم وتعلم منها. والفصيل هو ولد الناقة، يمشي في أثر أمه خطوة بخطوة.":{"s":[2,62.282,16.824]},"البعثة، ثم السنة الثالثة منهامكة":{"s":[2,79.456,4.824]},"أول من آمن، ويوم الدار":{"s":[2,84.63,3.696]},"ولقد كان يجاور في كل سنة بحراء، فأراه ولا يراه غيري، ولم يجمع بيت واحد يومئذ في الإسلام غير رسول الله صلى الله عليه وآله وخديجة وأنا ثالثهما، أرى نور الوحي والرسالة، وأشم ريح النبوة.":{"s":[2,88.676,19.68]},"بعث رسول الله صلى الله عليه وآله ولعلي عشر سنين، فصدقه وصلى معه، «ولم يكن يومئذ كافرا». وأقام معه بعد البعثة ثلاثا وعشرين سنة.":{"s":[3,0.0,15.024]},"﴿وأنذر عشيرتك الأقربين﴾":{"q":"26-214","o":"qs"},"فجمع رسول الله صلى الله عليه وآله بني عبد المطلب، فأطعمهم، ثم قال لهم:":{"s":[3,15.374,8.568]},"«فمن يجبني إلى هذا الأمر ويؤازرني عليه وعلى القيام به، يكن أخي ووصيي ووزيري ووارثي وخليفتي من بعدي»":{"s":[3,24.292,10.008]},"فسكت القوم، وقام علي عليه السلام، يقول: «وأنا إذ ذاك أصغرهم سنا». وأعادها رسول الله ثلاثا، وفي كل مرة لا يقوم غيره.":{"s":[3,34.65,14.184]},"«اجلس، فأنت أخي ووصيي ووزيري ووارثي وخليفتي من بعدي»":{"s":[3,49.184,6.6]},"ليلة الهجرةمكة":{"s":[3,56.134,3.288]},"ليلة المبيت":{"s":[3,59.772,2.448]},"ليلة المبيت، مكة، السنة الثالثة عشرة من البعثة":{"s":[3,62.57,6.096]},"وجاءه القوم الذين تمالؤوا على قتله فأحدقوا به وعليهم السلاح، يرصدون طلوع الفجر ليقتلوه ظاهرا، فيذهب دمه فرغا بمشاهدة بني هاشم قاتليه من جميع القبائل.":{"s":[3,69.016,15.504]},"فبات عليه السلام على فراش رسول الله صلى الله عليه وآله مستترا بإزاره، وخرج رسول الله إلى الغار.":{"s":[3,84.87,9.96]},"﴿ومن الناس من يشري نفسه ابتغاء مرضات الله ۗ والله رءوف بالعباد﴾":{"q":"2-207","o":"qs"},"«فوهب أمير المؤمنين عليه السلام نفسه لله، وشراها من الله»":{"s":[4,0.0,6.312]},"ثم لحق برسول الله صلى الله عليه وآله إلى المدينة.":{"s":[4,6.662,5.856]},"السنة الأولى والثانية للهجرةالمدينة":{"s":[4,12.868,4.704]},"الأخوة والزواج":{"s":[4,17.922,2.736]},"المؤاخاة":{"s":[4,21.008,2.064]},"«آخى رسول الله صلى الله عليه وآله بين أصحابه، وترك عليا»":{"s":[4,23.422,6.912]},"«والذي نفسي بيده، ما أخرتك إلا لنفسي، أنت أخي ووصيي ووارثي»":{"s":[4,30.684,7.032]},"فاطمة الزهراء عليها السلام":{"s":[4,38.066,3.6]},"وزوجه رسول الله صلى الله عليه وآله ابنته فاطمة الزهراء عليها السلام. وعن الإمام الصادق عليه السلام:":{"s":[4,42.016,11.328]},"«لولا أن الله تبارك وتعالى خلق أمير المؤمنين عليه السلام لفاطمة ما كان لها كفؤ على ظهر الأرض، من آدم ومن دونه»":{"s":[4,53.694,10.728]},"وولد لهما الإمام الحسن والإمام الحسين وزينب الكبرى وزينب الصغرى المكناة أم كلثوم.":{"s":[4,64.772,7.92]},"بعد الزواجالمدينة":{"s":[4,73.042,3.48]},"في بيت علي وفاطمة":{"s":[4,76.872,3.192]},"«تقاضى علي وفاطمة إلى رسول الله صلى الله عليه وآله في الخدمة، فقضى على فاطمة عليها السلام بخدمتها ما دون الباب، وقضى على علي عليه السلام بما خلفه».":{"s":[4,80.414,14.088]},"«فقالت فاطمة: فلا يعلم ما دخلني من السرور إلا الله، بإكفائي رسول الله صلى الله عليه وآله تحمل أرقاب الرجال»":{"s":[5,0.0,11.208]},"يحدث علي عليه السلام":{"s":[5,11.558,3.312]},"«ألا أحدثك عني وعن فاطمة الزهراء: أنها كانت عندي فاستقت بالقربة حتى أثر في صدرها، وطحنت بالرحى حتى مجلت يداها، وكسحت البيت حتى اغبرت ثيابها، وأوقدت تحت القدر حتى دكنت ثيابها»":{"s":[5,15.22,17.664]},"فأشار عليها أن تسأل أباها خادما، فعلمهما رسول الله صلى الله عليه وآله: «إذا أخذتما منامكما فكبرا أربعا وثلاثين تكبيرة، وسبحا ثلاثا وثلاثين تسبيحة، واحمدا ثلاثا وثلاثين تحميدة»":{"s":[5,33.234,18.624]},"الله أكبر":{"s":[5,52.208,3.984]},"سبحان الله":{"s":[5,56.542,4.032]},"الحمد لله":{"s":[5,60.924,4.056]},"«رضيت عن الله وعن رسوله، رضيت عن الله وعن رسوله»":{"s":[5,65.33,6.024]},"الإمام الحسن والإمام الحسين عليهما السلام":{"s":[5,71.704,4.728]},"وكان يضن بهما على الموت. رأى الحسن يتسرع إلى القتال يوم صفين فقال:":{"s":[5,76.782,8.088]},"«املكوا عني هذا الغلام لا يهدني، فإنني أنفس بهذين على الموت، لئلا ينقطع بهما نسل رسول الله صلى الله عليه وآله»":{"s":[5,85.22,11.4]},"ومر بكربلاء في طريقه إلى صفين، فقيل له: هذه كربلاء؟ قال: «ذات كرب وبلاء»، ثم أومأ بيده إلى مكان فقال: «هاهنا موضع رحالهم ومناخ ركابهم»، وأومأ بيده إلى موضع آخر فقال: «هاهنا مهراق دمائهم».":{"s":[6,0.0,22.536]},"رمضان هآبار بدر":{"s":[6,22.886,6.384]},"بدر":{"s":[6,29.62,1.872]},"يوم الفرقان":{"s":[6,31.842,2.4]},"خرج عتبة وشيبة ابنا ربيعة والوليد بن عتبة يطلبون البراز، فخرج إليهم عبيدة بن الحارث وحمزة وعلي: «وبارز الوليد أمير المؤمنين فلم يلبثه حتى قتله».":{"s":[6,34.592,15.0]},"من سبعين":{"s":[6,49.942,3.384]},"كان قتلى المشركين يوم بدر سبعين، يعد الشيخ المفيد منهم «خمسة وثلاثين رجلا، سوى من اختلف فيه، أو شرك أمير المؤمنين عليه السلام فيه غيره، وهم أكثر من شطر المقتولين».":{"s":[6,53.676,16.104]},"شوال هسفح أحد":{"s":[6,70.13,5.04]},"أحد":{"s":[6,75.52,1.872]},"حين انكشف المسلمون":{"s":[6,77.742,2.904]},"ترك الرماة الجبل، والتف المشركون من خلفهم، فانهزم الناس عن رسول الله صلى الله عليه وآله، وثبت علي يذب عنه.":{"s":[6,80.996,11.52]},"فقال جبرئيل: «إن هذه لهي المواساة يا محمد»، فقال: «إنه مني وأنا منه»، فقال جبرئيل: «وأنا منكما يا محمد».":{"s":[7,0.0,12.336]},"لا سيف إلا ذو الفقار، ولا فتى إلا علي":{"s":[7,12.686,4.824]},"نادى مناد من السماء يوم أحد":{"s":[7,17.86,3.672]},"شوال هشمال المدينة":{"s":[7,21.882,5.304]},"الخندق":{"s":[7,27.536,1.872]},"الأحزاب":{"s":[7,29.758,2.04]},"عبر عمرو بن عبد ود الخندق، فارس العرب، ونادى: هل من مبارز؟ فسكت الناس، وقام علي عليه السلام فقال: أنا له يا رسول الله.":{"s":[7,32.148,14.64]},"برز الإيمان كله إلى الشرك كله":{"s":[7,47.138,3.768]},"«لضربة علي لعمرو يوم الخندق تعدل عبادة الثقلين»":{"s":[7,51.256,5.472]},"وقول النبي صلى الله عليه وآله «برز الإيمان كله إلى الشرك كله» في بحار الأنوار : عن الكراجكي":{"s":[7,57.078,9.576]},"هحصون خيبر":{"s":[7,67.004,4.224]},"خيبر":{"s":[7,71.578,1.872]},"خيبر، ه":{"s":[7,73.8,3.864]},"«لأعطين الراية غدا رجلا يحب الله ورسوله ويحبه الله ورسوله، كرارا غير فرار، لا يرجع حتى يفتح الله على يديه»":{"s":[7,78.014,11.808]},"فبرز إليه مرحب، فأجابه علي عليه السلام: «أنا الذي سمتني أمي حيدره»":{"s":[8,0.0,7.632]},"واقتلع باب الحصن فتترس به، ثم رمى به خلف ظهره.":{"s":[8,7.982,5.592]},"«فلم يقله منهم إلا سبعون رجلا»":{"s":[8,13.924,4.032]},"«والله ما قلعت باب خيبر ورميت بها خلف ظهري أربعين ذراعا بقوة جسدية، ولا حركة غذائية، لكني أيدت بقوة ملكوتية، ونفس بنور ربها مضية»":{"s":[8,18.306,14.688]},"«فجيء به وهو أرمد، فتفل في عينه»، ثم دفع إليه الراية.":{"s":[8,33.344,6.768]},"وعن رسول الله صلى الله عليه وآله: «ورفع باب خيبر وهو ابن اثنتين وعشرين سنة، وكان لا يرفعه خمسون رجلا».":{"s":[8,40.462,10.968]},"رمضان همكة":{"s":[8,51.78,4.92]},"فتح مكة":{"s":[8,57.05,2.184]},"فتح مكة، رمضان ه":{"s":[8,59.584,6.12]},"صنما حول الكعبة":{"s":[8,66.054,4.248]},"كان بعضها مشدودا ببعض بالرصاص":{"s":[8,70.652,3.96]},"﴿وقل جاء الحق وزهق الباطل ۚ إن الباطل كان زهوقا﴾":{"q":"17-81","o":"qs"},"«أعطني يا علي كفا من الحصى»، فقبض له أمير المؤمنين كفا فناوله، فرماها به وهو يقول: ﴿قل جاء الحق وزهق الباطل﴾":{"q":"17-81a","o":"sq","s":[8,74.962,9.168]},"«فما بقي منها صنم إلا خر لوجهه، ثم أمر بها فأخرجت من المسجد فطرحت وكسرت»":{"s":[8,84.48,8.424]},"«وجد فيه ثلاثمائة وستين صنما، بعضها مشدود ببعض بالرصاص».":{"s":[9,0.0,7.032]},"شوال هوادي حنين":{"s":[9,7.382,5.376]},"حنين":{"s":[9,13.108,1.872]},"حنين، ه":{"s":[9,15.33,3.984]},"«فلما التقوا مع المشركين لم يلبثوا حتى انهزموا بأجمعهم، فلم يبق منهم مع النبي صلى الله عليه وآله إلا عشرة أنفس: تسعة من بني هاشم خاصة، وعاشرهم أيمن بن أم أيمن، فقتل أيمن رحمه الله، وثبت تسعة النفر الهاشميون حتى ثاب إلى رسول الله صلى الله عليه وآله من كان انهزم»":{"s":[9,19.664,26.496]},"وكان علي عليه السلام فيهم «بين يديه بالسيف».":{"s":[9,46.51,4.92]},"غزوة تبوك، هالمدينة":{"s":[9,51.78,5.52]},"حديث المنزلة":{"s":[9,57.65,2.448]},"حين خلفه على المدينة":{"s":[9,60.448,3.312]},"«أما ترضى أن تكون مني بمنزلة هارون من موسى، إلا أنه لا نبي بعدي»":{"s":[9,64.11,6.792]},"هارون من موسى، في القرآنعلي من محمد صلى الله عليه وآله":{"s":[9,71.252,6.96]},"وقال له حين خلفه: «ارجع يا أخي إلى مكانك، فإن المدينة لا تصلح إلا بي أو بك، فأنت خليفتي في أهلي ودار هجرتي وقومي».":{"s":[9,78.562,12.336]},"وفي السنة نفسها بعث بسورة براءة إلى الموسم، فنزل جبرئيل: «لا يؤدي عنك إلا أنت أو رجل منك»، فبعث بها عليا عليه السلام.":{"s":[10,0.0,12.432]},"ذي الحجة هالمدينة، مع نصارى نجران":{"s":[10,12.782,8.16]},"المباهلة والكساء":{"s":[10,21.292,2.808]},"﴿فمن حاجك فيه من بعد ما جاءك من العلم فقل تعالوا ندع أبناءنا وأبناءكم ونساءنا ونساءكم وأنفسنا وأنفسكم ثم نبتهل فنجعل لعنت الله على الكاذبين﴾":{"q":"3-61","o":"qs"},"«جاء النبي آخذا بيد أمير المؤمنين علي بن أبي طالب، والحسن والحسين بين يديه يمشيان، وفاطمة صلوات الله عليهم تمشي خلفه»":{"s":[10,24.45,12.408]},"رسول الله":{"s":[10,37.208,2.16]},"علي":{"s":[10,39.718,1.872]},"فاطمة":{"s":[10,41.94,1.896]},"الإمام الحسن":{"s":[10,44.186,2.4]},"الإمام الحسين":{"s":[10,46.936,2.544]},"«فأدخلهم رسول الله تحت الكساء في بيت أم سلمة، ثم قال: اللهم إن لكل نبي أهلا وثقلا، وهؤلاء أهل بيتي وثقلي»":{"s":[10,49.83,11.904]},"﴿إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرا﴾":{"q":"33-33a","o":"qs"},"في حياة النبي صلى الله عليه وآلهاليمن":{"s":[10,62.084,5.256]},"قاضيا في اليمن":{"s":[10,67.69,2.472]},"قبل أن يخرج":{"s":[10,70.512,2.328]},"قال أمير المؤمنين عليه السلام: «تنفذني يا رسول الله للقضاء وأنا شاب ولا علم لي بكل القضاء»، فقال له: «ادن مني»، فدنا منه فضرب على صدره بيده، وقال:":{"s":[10,73.19,15.312]},"«اللهم اهد قلبه وثبت لسانه»":{"s":[10,88.852,3.72]},"«فما شككت في قضاء بين اثنين بعد ذلك المقام»":{"s":[11,0.0,5.064]},"ومن قضائه وهو باليمن، خبر زبية حفرت للأسد فوقع فيها أربعة، كل يجذب صاحبه:":{"s":[11,5.414,8.76]},"«فقضى عليه السلام أن الأول فريسة الأسد وعليه ثلث الدية للثاني، وعلى الثاني ثلثا الدية للثالث، وعلى الثالث الدية كاملة للرابع». وانتهى الخبر إلى رسول الله صلى الله عليه وآله فقال: «لقد قضى أبو الحسن فيهم بقضاء الله عز وجل فوق عرشه»":{"s":[11,14.524,22.368]},"ذي الحجة هغدير خم":{"s":[11,37.242,6.12]},"غدير خم":{"s":[11,43.712,2.184]},"غدير خم، ذي الحجة ه":{"s":[11,46.246,6.672]},"﴿يا أيها الرسول بلغ ما أنزل إليك من ربك ۖ وإن لم تفعل فما بلغت رسالته ۚ والله يعصمك من الناس﴾":{"q":"5-67a","o":"qs"},"وأمر بجمع الرحال في ذلك المكان، ووضع بعضها على بعض، ثم صعد عليها حتى صار في ذروتها.":{"s":[11,53.268,9.48]},"ورفع يد علي حتى رئي بياض إبطيهما":{"s":[11,63.098,4.512]},"«من كنت مولاه فهذا علي مولاه، اللهم وال من والاه، وعاد من عاداه، وانصر من نصره، واخذل من خذله»":{"s":[11,67.96,10.536]},"﴿اليوم أكملت لكم دينكم وأتممت عليكم نعمتي ورضيت لكم الإسلام دينا﴾":{"q":"5-3a","o":"qs"},"صفر ه، في رواية المفيدالمدينة":{"s":[11,78.846,8.616]},"رحيل رسول الله":{"s":[11,87.812,2.496]},"نهج البلاغة، الخطبة":{"s":[12,0.0,5.4]},"ولقد قبض رسول الله صلى الله عليه وآله وإن رأسه لعلى صدري، ولقد سالت نفسه في كفي، فأمررتها على وجهي، ولقد وليت غسله صلى الله عليه وآله والملائكة أعواني":{"s":[12,5.75,16.464]},"— هالمدينة":{"s":[12,22.564,6.504]},"سنوات الصبر":{"s":[12,29.418,2.304]},"وبينما كان عليه السلام مشغولا بتجهيز رسول الله صلى الله عليه وآله ودفنه، اجتمع قوم في سقيفة بني ساعدة فعقدوا الأمر لغيره. فكانت إمامته بعد النبي ثلاثين سنة، «منها أربع وعشرون سنة وأشهر ممنوعا من التصرف على أحكامها». وفي الخطبة الشقشقية يصف تلك السنين:":{"s":[12,32.072,26.28]},"أما والله لقد تقمصها فلان وإنه ليعلم أن محلي منها محل القطب من الرحى":{"s":[12,58.702,7.512]},"ينحدر عني السيل، ولا يرقى إلي الطير":{"s":[12,66.564,4.488]},"فصبرت وفي العين قذى، وفي الحلق شجا، أرى تراثي نهبا":{"s":[12,71.402,6.696]},"«وبقيت بعد أبيها خمسة وسبعين يوما»، ولها ثماني عشرة سنة. «ولما قبضت فاطمة عليها السلام دفنها أمير المؤمنين سرا، وعفا على موضع قبرها». «فلما حضرتها الوفاة وصت أمير المؤمنين عليه السلام أن يتولى أمرها، ويدفنها ليلا، ويعفي قبرها». وقال عند دفنها، مخاطبا رسول الله صلى الله عليه وآله:":{"s":[12,78.448,31.032]},"السلام عليك يا رسول الله عني، وعن ابنتك النازلة في جوارك، والسريعة اللحاق بك. قل يا رسول الله عن صفيتك صبري، ورق عنها تجلدي … أما حزني فسرمد، وأما ليلي فمسهد":{"s":[13,0.0,18.504]},"جمع القرآن":{"s":[13,18.854,2.448]},"«فلما رأى علي عليه السلام غدرهم، وقلة وفائهم له، لزم بيته، وأقبل على القرآن يؤلفه ويجمعه، فلم يخرج من بيته حتى جمعه»":{"s":[13,21.652,13.224]},"وبعث إليه القوم يدعونه، فبعث إليهم: «أني مشغول، وقد آليت على نفسي يمينا أن لا أرتدي برداء إلا للصلاة حتى أؤلف القرآن وأجمعه».":{"s":[13,35.226,12.96]},"فدك":{"s":[13,48.536,1.872]},"وكتب بعد ذلك إلى عامله عثمان بن حنيف:":{"s":[13,50.758,4.656]},"«بلى! كانت في أيدينا فدك من كل ما أظلته السماء، فشحت عليها نفوس قوم، وسخت عنها نفوس قوم آخرين، ونعم الحكم الله»":{"s":[13,55.764,13.104]},"في تلك السنين، من كد يده":{"s":[13,69.218,3.72]},"نفس أعتقها":{"s":[13,73.288,2.76]},"«وأعتق ألف مملوك من كد يده»":{"s":[13,76.398,3.744]},"هالمدينة، ثم الكوفة":{"s":[13,80.492,5.928]},"البيعة والعدل":{"s":[13,86.77,2.448]},"المدينة، ه":{"s":[13,89.568,4.704]},"فما راعني إلا والناس كعرف الضبع إلي، ينثالون علي من كل جانب، حتى لقد وطئ الحسنان، وشق عطفاي":{"s":[14,0.0,10.56]},"أما والذي فلق الحبة، وبرأ النسمة، لولا حضور الحاضر، وقيام الحجة بوجود الناصر، وما أخذ الله على العلماء ألا يقاروا على كظة ظالم، ولا سغب مظلوم، لألقيت حبلها على غاربها … ولألفيتم دنياكم هذه أزهد عندي من عفطة عنز":{"s":[14,10.91,21.672]},"وأول ما بدأ به رد ما أقطع من مال المسلمين بغير حق:":{"s":[14,32.932,5.616]},"والله لو وجدته قد تزوج به النساء، وملك به الإماء لرددته؛ فإن في العدل سعة، ومن ضاق عليه العدل فالجور عليه أضيق":{"s":[14,38.898,11.592]},"وجاءه أخوه عقيل يطلب من بيت المال فوق حقه:":{"s":[14,50.84,5.112]},"والله لقد رأيت عقيلا وقد أملق حتى استماحني من بركم صاعا … فأحميت له حديدة، ثم أدنيتها من جسمه ليعتبر بها … ثكلتك الثواكل يا عقيل! أتئن من حديدة أحماها إنسانها للعبه، وتجرني إلى نار سجرها جبارها لغضبه":{"s":[14,56.302,21.48]},"وبلغه أن خيل معاوية أغارت على الأنبار، فقال:":{"s":[14,78.132,5.712]},"«ولقد بلغني أن الرجل منهم كان يدخل على المرأة المسلمة، والأخرى المعاهدة، فينتزع حجلها وقلبها وقلائدها ورعثها … فلو أن امرأ مسلما مات من بعد هذا أسفا ما كان به ملوما، بل كان به عندي جديرا»":{"s":[14,84.194,18.432]},"في أسواق الكوفة":{"s":[15,0.0,2.688]},"«كان أمير المؤمنين عليه السلام بالكوفة عندكم يغتدي كل يوم بكرة من القصر، فيطوف في أسواق الكوفة سوقا سوقا، ومعه الدرة على عاتقه … فيقف على أهل كل سوق فينادي: يا معشر التجار، اتقوا الله عز وجل»":{"s":[15,3.038,19.824]},"وكان يقول على المنبر: «يا معشر التجار، الفقه ثم المتجر، الفقه ثم المتجر، الفقه ثم المتجر».":{"s":[15,23.212,9.912]},"الأرملة":{"s":[15,33.474,2.064]},"«ونظر علي إلى امرأة على كتفها قربة ماء، فأخذ منها القربة فحملها إلى موضعها، وسألها عن حالها … فانصرف وبات ليلته قلقا، فلما أصبح حمل زنبيلا فيه طعام، فقال بعضهم: أعطني أحمله عنك، فقال: من يحمل وزري عني يوم القيامة؟ … ذق يا علي، هذا جزاء من ضيع الأرامل واليتامى»":{"s":[15,35.888,28.512]},"«والله لو أعطيت الأقاليم السبعة بما تحت أفلاكها»":{"s":[15,64.75,5.16]},"«على أن أعصي الله في نملة أسلبها جلب شعيرة»":{"s":[15,70.26,5.04]},"«ما فعلته»":{"s":[15,75.65,1.944]},"وكتب إلى مالك الأشتر حين ولاه مصر:":{"s":[15,77.944,4.344]},"وأشعر قلبك الرحمة للرعية، والمحبة لهم، واللطف بهم، ولا تكونن عليهم سبعا ضاريا تغتنم أكلهم، فإنهم صنفان: إما أخ لك في الدين، وإما نظير لك في الخلق":{"s":[15,82.638,16.536]},"وكتب إلى عامله على البصرة عثمان بن حنيف:":{"s":[16,0.0,4.752]},"ألا وإن لكل مأموم إماما يقتدي به، ويستضيء بنور علمه. ألا وإن إمامكم قد اكتفى من دنياه بطمريه، ومن طعمه بقرصيه … ولو شئت لاهتديت الطريق إلى مصفى هذا العسل، ولباب هذا القمح، ونسائج هذا القز، ولكن هيهات أن يغلبني هواي … ولعل بالحجاز أو اليمامة من لا طمع له في القرص، ولا عهد له بالشبع":{"s":[16,5.102,29.568]},"عهد الأشتر، نهج البلاغة، الكتاب":{"s":[16,35.02,6.0]},"«واعلم أن الرعية طبقات لا يصلح بعضها إلا ببعض، ولا غنى ببعضها عن بعض»":{"s":[16,41.37,7.416]},"جنود الله":{"s":[16,49.136,2.16]},"كتاب العامة والخاصة":{"s":[16,51.646,3.072]},"قضاة العدل":{"s":[16,55.068,2.064]},"عمال الإنصاف والرفق":{"s":[16,57.482,2.856]},"أهل الجزية والخراج":{"s":[16,60.688,2.688]},"التجار وأهل الصناعات":{"s":[16,63.726,3.12]},"الطبقة السفلى":{"s":[16,67.196,2.304]},"«ثم الله الله في الطبقة السفلى من الذين لا حيلة لهم من المساكين والمحتاجين وأهل البؤسى والزمنى، فإن في هذه الطبقة قانعا ومعترا»":{"s":[16,69.85,11.736]},"قضاؤه":{"s":[16,81.936,1.872]},"«ايتوني بمنشار»… «أقده نصفين، لكل واحدة منكما نصفه». فسكتت إحداهما وقالت الأخرى: الله الله يا أبا الحسن… فقال: «الله أكبر، هذا ابنك دونها، ولو كان ابنها لرقت عليه وأشفقت»":{"s":[16,84.158,20.04]},"«اصطحبا في سفر فجلسا يتغديان، فأخرج أحدهما خمسة أرغفة وأخرج الآخر ثلاثة أرغفة… فلما فرغ من أكله رمى إليهما ثمانية دراهم». فقال لصاحب الثلاثة: «…فإن لك واحدا من ثمانية، ولصاحبك سبعة»":{"s":[17,0.0,20.304]},"«فوجد شابا حدثا يبكي… ثم أمر بهم أن يفرقوا، ففرقوا في المسجد، وأقيم كل رجل منهم إلى جانب أسطوانة من أساطين المسجد… فلما انتهى إقراره إلى دفنه، كبر أمير المؤمنين تكبيرة سمعها أهل المسجد»":{"s":[17,20.654,19.416]},"جمادى الأولى هالبصرة":{"s":[17,40.42,6.024]},"الجمل":{"s":[17,46.794,1.872]},"قال عليه السلام: «أمرت بقتال الناكثين والقاسطين والمارقين». قال الصدوق: الناكثون أصحاب الجمل، والقاسطون أهل الشام ومعاوية، والمارقون أهل النهروان.":{"s":[17,49.016,16.152]},"الناكثونالجمل، ه":{"s":[17,65.518,5.784]},"القاسطونصفين، ه":{"s":[17,71.652,6.288]},"المارقونالنهروان، ه":{"s":[17,78.29,6.456]},"الناكثون":{"s":[17,85.096,2.088]},"نكث طلحة والزبير بيعته، وخرجا ومعهما عائشة على جمل في هودج، حتى نزلوا البصرة.":{"s":[17,87.534,9.192]},"والتقى الجمعان «غداة الخميس لعشر مضين من جمادى الأولى» سنة ست وثلاثين.":{"s":[18,0.0,6.912]},"«نظرت الهودج يوم الجمل وهو كأنه قنفذ من النشاب والنبل». فقال عليه السلام: «عرقبوا الجمل»، «فتبادر إليه أصحاب أمير المؤمنين فعرقبوه، ووقع لجنبه».":{"s":[18,7.262,15.144]},"ثم رد عائشة إلى المدينة، «وأنفذ معها أربعين امرأة ألبسهن العمائم والقلانس وقلدهن السيوف»":{"s":[18,22.756,9.696]},"هصفين، على الفرات":{"s":[18,32.802,6.096]},"صفين":{"s":[18,39.248,1.944]},"صفين، ه، على الفرات":{"s":[18,41.542,6.168]},"سبق أهل الشام إلى شريعة الفرات فمنعوا أصحاب علي عليه السلام الماء.":{"s":[18,48.06,6.648]},"«خذوا من الماء حاجتكم وارجعوا إلى عسكركم، وخلوا بينهم وبين الماء، فإن الله قد نصركم ببغيهم وظلمهم»":{"s":[18,55.058,10.248]},"«إنك من أهل الجنة، تقتلك الفئة الباغية»":{"s":[18,65.656,4.584]},"قالها النبي صلى الله عليه وآله لعمار بن ياسر، فقتل عمار في صفين مع علي عليه السلام.":{"s":[18,70.59,9.336]},"ليلة الهرير: قتال لم ينقطع حتى الصباح، وكاد أهل الشام ينكسرون.":{"s":[18,80.276,7.488]},"«إنهم والله ما رفعوها أنهم يعرفونها ويعملون بها، ولكنها الخديعة والوهن والمكيدة»":{"s":[18,88.114,8.976]},"فأكره على التحكيم، وتوقف القتال على حافة النصر.":{"s":[19,0.0,5.736]},"هحاضرين، في طريق العودة من صفين":{"s":[19,6.086,7.008]},"وصيته للحسن":{"s":[19,13.444,2.688]},"نهج البلاغة، الكتاب : «ومن وصية له عليه السلام للحسن بن علي عليهما السلام، كتبها إليه بحاضرين عند انصرافه من صفين»":{"s":[19,16.482,13.728]},"من":{"s":[19,30.56,1.872]},"الوالد الفان":{"s":[19,32.782,2.496]},"المقر للزمان":{"s":[19,35.628,2.592]},"المدبر العمر":{"s":[19,38.57,2.184]},"المستسلم للدهر":{"s":[19,41.104,2.472]},"الذام للدنيا":{"s":[19,43.926,2.352]},"الساكن مساكن الموتى":{"s":[19,46.628,3.024]},"والظاعن عنها غدا":{"s":[19,50.002,2.736]},"إلى":{"s":[19,53.088,1.872]},"المولود المؤمل ما لا يدرك":{"s":[19,55.31,3.336]},"السالك سبيل من قد هلك":{"s":[19,58.996,3.192]},"غرض الأسقام":{"s":[19,62.538,2.352]},"ورهينة الأيام":{"s":[19,65.24,2.712]},"ورمية المصائب":{"s":[19,68.302,2.592]},"وعبد الدنيا":{"s":[19,71.244,2.256]},"وتاجر الغرور":{"s":[19,73.85,2.544]},"وغريم المنايا":{"s":[19,76.744,2.52]},"وأسير الموت":{"s":[19,79.614,2.232]},"وحليف الهموم":{"s":[19,82.196,2.472]},"وقرين الأحزان":{"s":[19,85.018,2.64]},"ونصب الآفات":{"s":[19,88.008,2.496]},"وصريع الشهوات":{"s":[20,0.0,2.712]},"وخليفة الأموات":{"s":[20,3.062,2.64]},"«ووجدتك بعضي، بل وجدتك كلي، حتى كأن شيئا لو أصابك أصابني، وكأن الموت لو أتاك أتاني»":{"s":[20,6.052,10.104]},"من الوصية":{"s":[20,16.506,2.376]},"في التقوى «فإني أوصيك بتقوى الله، أي بني، ولزوم أمره، وعمارة قلبك بذكره، والاعتصام بحبله»":{"s":[20,19.232,10.56]},"في القلب «أحي قلبك بالموعظة، وأمته بالزهادة، وقوه باليقين، ونوره بالحكمة، وذلله بذكر الموت»":{"s":[20,30.142,11.064]},"لماذا كتبها مبكرا «وإنما قلب الحدث كالأرض الخالية، ما ألقي فيها من شيء قبلته، فبادرتك بالأدب قبل أن يقسو قلبك، ويشتغل لبك»":{"s":[20,41.556,14.208]},"في التجربة «أي بني، إني وإن لم أكن عمرت عمر من كان قبلي، فقد نظرت في أعمالهم، وفكرت في أخبارهم، وسرت في آثارهم، حتى عدت كأحدهم»":{"s":[20,56.114,14.736]},"الميزان «يا بني، اجعل نفسك ميزانا فيما بينك وبين غيرك، فأحبب لغيرك ما تحب لنفسك، واكره له ما تكره لها، ولا تظلم كما لا تحب أن تظلم، وأحسن كما تحب أن يحسن إليك»":{"s":[20,71.2,17.208]},"في الأجل «واعلم يقينا أنك لن تبلغ أملك، ولن تعدو أجلك»":{"s":[20,88.758,6.48]},"في القرب والبعد «ورب بعيد أقرب من قريب، وقريب أبعد من بعيد، والغريب من لم يكن له حبيب»":{"s":[21,0.0,9.792]},"في الحق «وخض الغمرات للحق حيث كان»":{"s":[21,10.142,4.704]},"هالنهروان":{"s":[21,15.196,4.704]},"النهروان":{"s":[21,20.25,1.992]},"خرجت عليه بعد التحكيم جماعة من جيشه رفعت شعار «لا حكم إلا لله»، فقال:":{"s":[21,22.592,7.944]},"كلمة حق يراد بها باطل":{"s":[21,30.886,3.408]},"قبل القتال، عند الجسر":{"s":[21,34.644,3.456]},"مصارعهم دون النطفة، والله لا يفلت منهم عشرة، ولا يهلك منكم عشرة":{"s":[21,38.45,7.584]},"وبعد القتال جعل يطلب ذا الثدية في القتلى ويقول: «والله ما كذبت ولا كذبت»، حتى وجده.":{"s":[21,46.384,9.048]},"لا تقاتلوا الخوارج بعدي، فليس من طلب الحق فأخطأه، كمن طلب الباطل فأدركه":{"s":[21,55.782,7.968]},"— رمضان هالكوفة":{"s":[21,64.1,8.112]},"المحراب، والأيام الثلاثة":{"s":[21,72.562,3.984]},"«وقد خرج عليه السلام يوقظ الناس لصلاة الصبح ليلة تسع عشرة من شهر رمضان»، فضربه ابن ملجم المرادي في مسجد الكوفة بسيف مسموم.":{"s":[21,76.896,12.432]},"فزت ورب الكعبة":{"s":[21,89.678,2.808]},"ولد في جوف الكعبة، وفاز برب الكعبة.":{"s":[22,0.0,4.704]},"ليلة التاسع عشر":{"s":[22,5.054,2.736]},"في بيته، قبيل الفجر":{"s":[22,8.14,3.144]},"«سهر تلك الليلة، فأكثر الخروج والنظر في السماء وهو يقول: والله ما كذبت ولا كذبت، وإنها الليلة التي وعدت بها، ثم يعاود مضجعه، فلما طلع الفجر شد إزاره وخرج»":{"s":[22,11.634,16.224]},"«فلما خرج إلى صحن الدار استقبلته الإوز فصحن في وجهه، فجعلوا يطردونهن، فقال: دعوهن فإنهن نوائح»":{"s":[22,28.208,10.8]},"فجر التاسع عشر":{"s":[22,39.358,2.616]},"مسجد الكوفة":{"s":[22,42.324,2.4]},"«وقد خرج عليه السلام يوقظ الناس لصلاة الصبح»، فضربه ابن ملجم المرادي بالسيف على رأسه، «وكان سيفه مسموما».":{"s":[22,45.074,10.8]},"«فزت ورب الكعبة»":{"s":[22,56.224,2.808]},"على فراشه":{"s":[22,59.382,2.064]},"التاسع عشر والعشرون":{"s":[22,61.796,3.072]},"«أنا بالأمس صاحبكم، واليوم عبرة لكم، وغدا مفارقكم»":{"s":[22,65.218,6.576]},"«إن أبق فأنا ولي دمي، وإن أفن فالفناء ميعادي، وإن أعف فالعفو لي قربة، وهو لكم حسنة، فاعفوا، ألا تحبون أن يغفر الله لكم؟»":{"s":[22,72.144,12.816]},"وقال في ابن ملجم: «النفس بالنفس، إن أنا مت فاقتلوه كما قتلني، وإن سلمت رأيت فيه رأيي»":{"s":[22,85.31,9.36]},"الوصية إلى الإمام الحسن":{"s":[23,0.0,3.192]},"بحضرة ولده وأهل بيته":{"s":[23,3.542,3.312]},"«وأشهد على وصيته الحسين عليه السلام ومحمدا وجميع ولده ورؤساء شيعته وأهل بيته، ثم دفع إليه الكتاب والسلاح»، وقال:":{"s":[23,7.204,12.36]},"«يا بني، أمرني رسول الله صلى الله عليه وآله أن أوصي إليك، وأن أدفع إليك كتبي وسلاحي، كما أوصى إلي رسول الله صلى الله عليه وآله ودفع إلي كتبه وسلاحه، وأمرني أن آمرك إذا حضرك الموت أن تدفعها إلى أخيك الحسين»":{"s":[23,19.914,20.88]},"«أوصيكما بتقوى الله، وألا تبغيا الدنيا وإن بغتكما»":{"s":[23,41.144,5.88]},"«الله الله في الأيتام»":{"s":[23,47.374,2.904]},"«الله الله في جيرانكم»":{"s":[23,50.628,3.216]},"«الله الله في القرآن»":{"s":[23,54.194,2.904]},"«الله الله في الصلاة، فإنها عمود دينكم»":{"s":[23,57.448,4.872]},"ليلة الحادي والعشرين":{"s":[23,62.67,3.072]},"قبيل الفجر":{"s":[23,66.092,2.088]},"«والله ما فجأني من الموت وارد كرهته، ولا طالع أنكرته، وما كنت إلا كقارب ورد، وطالب وجد»":{"s":[23,68.53,10.176]},"«وكانت وفاته قبيل الفجر من ليلة الجمعة، ليلة إحدى وعشرين من شهر رمضان سنة أربعين من الهجرة»، «وكان سنه يوم وفاته ثلاثا وستين سنة».":{"s":[23,79.056,13.152]},"وبعد دفنه أمر الحسن عليه السلام بابن ملجم «فضربت عنقه».":{"s":[24,0.0,5.784]},"وأوصى بني عبد المطلب: «لا ألفينكم تخوضون دماء المسلمين خوضا، تقولون: قتل أمير المؤمنين. ألا لا تقتلن بي إلا قاتلي».":{"s":[24,6.134,13.176]},"وقال قبل موته: «غدا ترون أيامي، ويكشف لكم عن سرائري، وتعرفونني بعد خلو مكاني وقيام غيري مقامي».":{"s":[24,19.66,11.136]},"رمضان هظهر الكوفة":{"s":[24,31.146,5.568]},"المرقد في الغري":{"s":[24,37.064,2.544]},"ليلة الحادي والعشرين من رمضان ه":{"s":[24,39.958,6.072]},"«لما مات احتمله الحسن عليه السلام، فأتى به ظهر الكوفة قريبا من النجف، يسرة عن الغري، يمنة عن الحيرة، فدفنه…»":{"s":[24,46.38,11.544]},"سنوات والقبر لا يعرف":{"s":[24,58.274,3.36]},"«فلم يزل قبره عليه السلام مخفيا حتى دل عليه الصادق جعفر بن محمد عليهما السلام في الدولة العباسية»":{"s":[24,61.984,9.912]},"يقول الراوي: «أتيته مع أبي عبد الله عليه السلام حيث كان بالحيرة غير مرة، وخبرني أنه قبره»":{"s":[24,72.246,9.528]},"«وزاره عند وروده إلى أبي جعفر وهو بالحيرة، فعرفته الشيعة، واستأنفوا إذ ذاك زيارته»":{"s":[24,82.124,8.64]},"السلام عليك يا أمير المؤمنين":{"s":[25,0.0,3.696]},"مرقده في النجف الأشرف":{"s":[25,4.046,3.048]},"غسله ابناه الحسن والحسين عليهما السلام، وحملاه إلى الغري من نجف الكوفة، وأخفيا قبره بوصية منه.":{"s":[25,7.444,10.32]},"«فلم يزل قبره عليه السلام مخفيا حتى دل عليه الصادق جعفر بن محمد عليهما السلام في الدولة العباسية». وهناك اليوم مرقده في النجف الأشرف، تقصده الزائرون من كل مكان.":{"s":[25,18.114,16.584]},"من علمه":{"s":[25,35.048,1.92]},"«…رسول الله صلى الله عليه وآله علمني ألف باب من العلم، يفتح كل باب ألف باب، ولم يعلم ذلك أحدا غيري»":{"s":[25,37.318,11.112]},"«…كل باب منها يفتح ألف باب، فذلك ألف ألف باب، حتى علمت علم المنايا والبلايا وفصل الخطاب»":{"s":[25,48.78,9.6]},"نهج البلاغة، الخطبة الأولى":{"s":[25,58.73,3.792]},"أول الدين معرفته":{"s":[25,62.872,3.024]},"وكمال معرفته التصديق به":{"s":[25,66.246,3.528]},"وكمال التصديق به توحيده":{"s":[25,70.124,3.552]},"وكمال توحيده الإخلاص له":{"s":[25,74.026,3.504]},"وكمال الإخلاص له نفي الصفات عنه":{"s":[25,77.88,4.104]},"نهج البلاغة، الخطبة فاسألوني قبل أن تفقدوني":{"s":[25,82.334,7.104]},"قيمة كل امرئ ما يحسنه":{"s":[25,89.788,3.216]},"الناس أعداء ما جهلوا":{"s":[26,0.0,2.952]},"إذا تم العقل نقص الكلام":{"s":[26,3.302,3.456]},"المرء مخبوء تحت لسانه":{"s":[26,7.108,3.264]},"لا غنى كالعقل، ولا فقر كالجهل، ولا ميراث كالأدب، ولا ظهير كالمشاورة":{"s":[26,10.722,8.256]},"من حذرك كمن بشرك":{"s":[26,19.328,3.024]},"إذا قدرت على عدوك فاجعل العفو عنه شكرا للقدرة عليه":{"s":[26,22.702,5.616]},"أعجز الناس من عجز عن اكتساب الإخوان، وأعجز منه من ضيع من ظفر به منهم":{"s":[26,28.668,7.632]},"… والفرصة تمر مر السحاب، فانتهزوا فرص الخير":{"s":[26,36.65,5.328]},"ما أضمر أحد شيئا إلا ظهر في فلتات لسانه، وصفحات وجهه":{"s":[26,42.328,6.6]},"من أطال الأمل أساء العمل":{"s":[26,49.278,3.384]},"صدر العاقل صندوق سره":{"s":[26,53.012,3.216]},"إذا أقبلت الدنيا على أحد أعارته محاسن غيره، وإذا أدبرت عنه سلبته محاسن نفسه":{"s":[26,56.578,8.136]},"كن في الفتنة كابن اللبون، لا ظهر فيركب، ولا ضرع فيحلب":{"s":[26,65.064,6.552]},"البخل عار، والجبن منقصة، والفقر يخرس الفطن عن حجته، والمقل غريب في بلدته":{"s":[26,71.966,8.544]},"لا تستح من إعطاء القليل، فإن الحرمان أقل منه":{"s":[26,80.86,5.448]},"حكمة اليوم":{"s":[26,86.658,2.28]},"من نصب نفسه للناس إماما فليبدأ بتعليم نفسه قبل تعليم غيره، وليكن تأديبه بسيرته قبل تأديبه بلسانه":{"s":[26,89.288,10.584]},"الحكمة ضالة المؤمن، فخذ الحكمة ولو من أهل النفاق":{"s":[27,0.0,5.856]},"رأي الشيخ أحب إلي من جلد الغلام":{"s":[27,6.206,4.08]},"إن هذه القلوب تمل كما تمل الأبدان، فابتغوا لها طرائف الحكم":{"s":[27,10.636,6.624]},"لا يقيم أمر الله سبحانه إلا من لا يصانع، ولا يضارع، ولا يتبع المطامع":{"s":[27,17.61,8.304]},"ما أكثر العبر وأقل الاعتبار":{"s":[27,26.264,3.624]},"كفى بالأجل حارسا":{"s":[27,30.238,2.712]},"… والدهر يومان: يوم لك، ويوم عليك، فإذا كان لك فلا تبطر، وإذا كان عليك فاصبر":{"s":[27,33.3,9.264]},"الحلم غطاء ساتر، والعقل حسام قاطع":{"s":[27,42.914,4.92]},"ليس بلد بأحق بك من بلد، خير البلاد ما حملك":{"s":[27,48.184,5.4]},"ولا تكن عبد غيرك وقد جعلك الله حرا":{"s":[27,53.934,4.608]},"… إنك لم تعرف الحق فتعرف من أتاه، ولم تعرف الباطل فتعرف من أتاه":{"s":[27,58.892,6.744]},"ثلاث عبادات، الحكمة":{"s":[27,65.986,5.88]},"عبادة التجارإن قوما عبدوا الله رغبة":{"s":[27,72.216,4.944]},"عبادة العبيدوإن قوما عبدوا الله رهبة":{"s":[27,77.51,5.28]},"عبادة الأحراروإن قوما عبدوا الله شكرا":{"s":[27,83.14,5.088]},"إلى كميل بن زياد، الحكمة":{"s":[27,88.578,6.144]},"عالم رباني":{"s":[28,0.0,2.592]},"ومتعلم على سبيل نجاة":{"s":[28,2.942,3.504]},"وهمج رعاعأتباع كل ناعق":{"s":[28,6.796,4.08]},"يا كميل، العلم خير من المال: العلم يحرسك وأنت تحرس المال، والمال تنقصه النفقة، والعلم يزكو على الإنفاق.":{"s":[28,11.226,11.4]},"في عجيب الخلق":{"s":[28,22.976,2.352]},"انظروا إلى النملة في صغر جثتها، ولطافة هيئتها، لا تكاد تنال بلحظ البصر، ولا بمستدرك الفكر، كيف دبت على أرضها، وصبت على رزقها، تنقل الحبة إلى جحرها، وتعدها في مستقرها":{"s":[28,25.678,18.504]},"ومن لطائف صنعته، وعجائب خلقته، ما أرانا من غوامض الحكمة في هذه الخفافيش التي يقبضها الضياء الباسط لكل شيء، ويبسطها الظلام القابض لكل حي":{"s":[28,44.532,14.016]},"ومن أعجبها خلقا الطاوس الذي أقامه في أحكم تعديل، ونضد ألوانه في أحسن تنضيد":{"s":[28,58.898,8.304]},"من مناجاته: دعاء الصباح":{"s":[28,67.552,3.816]},"«اللهم يا من دلع لسان الصباح بنطق تبلجه، وسرح قطع الليل المظلم بغياهب تلجلجه، وأتقن صنع الفلك الدوار في مقادير تبرجه، وشعشع ضياء الشمس بنور تأججه، يا من دل على ذاته بذاته، وتنزه عن مجانسة مخلوقاته، وجل عن ملاءمة كيفياته»":{"s":[28,71.718,23.424]},"«كان أمير المؤمنين عليه السلام يدعو بعد ركعتي الفجر بهذا الدعاء». يرويه المجلسي بلا سند، وينبه محقق البحار إلى ضعف أسانيد هذه الأدعية.":{"s":[29,0.0,14.064]},"نهج البلاغة، الخطبة ، في صفة المتقين: «فالمتقون فيها هم أهل الفضائل:»":{"s":[29,14.414,9.984]},"منطقهم الصواب":{"s":[29,24.748,2.64]},"وملبسهم الاقتصاد":{"s":[29,27.738,2.952]},"ومشيهم التواضع":{"s":[29,31.04,2.736]},"غضوا أبصارهم عما حرم الله عليهم":{"s":[29,34.126,4.224]},"ووقفوا أسماعهم على العلم النافع لهم":{"s":[29,38.7,4.2]},"نزلت أنفسهم منهم في البلاء كالتي نزلت في الرخاء":{"s":[29,43.25,5.376]},"ولولا الأجل الذي كتب الله عليهم لم تستقر أرواحهم في أجسادهم طرفة عين، شوقا إلى الثواب، وخوفا من العقاب":{"s":[29,48.976,10.944]},"عظم الخالق في أنفسهم فصغر ما دونه في أعينهم":{"s":[29,60.27,5.424]},"فهم والجنة كمن قد رآها فهم فيها منعمون":{"s":[29,66.044,4.92]},"وهم والنار كمن قد رآها فهم فيها معذبون":{"s":[29,71.314,4.752]},"قلوبهم محزونة":{"s":[29,76.416,2.616]},"وشرورهم مأمونة":{"s":[29,79.382,2.904]},"وأجسادهم نحيفة":{"s":[29,82.636,2.88]},"وحاجاتهم خفيفة":{"s":[29,85.866,3.048]},"وأنفسهم عفيفة":{"s":[29,89.264,2.856]},"صبروا أياما قصيرة أعقبتهم راحة طويلة":{"s":[30,0.0,5.256]},"تجارة مربحة يسرها لهم ربهم":{"s":[30,5.606,4.152]},"أرادتهم الدنيا فلم يريدوها":{"s":[30,10.108,3.504]},"وأسرتهم ففدوا أنفسهم منها":{"s":[30,13.962,3.72]},"أما الليل فصافون أقدامهم، تالين لأجزاء القرآن يرتلونها ترتيلا":{"s":[30,18.032,6.984]},"يحزنون به أنفسهم ويستثيرون به دواء دائهم":{"s":[30,25.366,5.448]},"وأما النهار فحلماء علماء أبرار أتقياء":{"s":[30,31.164,4.752]},"قد براهم الخوف بري القداح":{"s":[30,36.266,3.384]},"لا يرضون من أعمالهم القليل، ولا يستكثرون الكثير":{"s":[30,40.0,5.616]},"فهم لأنفسهم متهمون، ومن أعمالهم مشفقون":{"s":[30,45.966,5.688]},"في القرآن والسنة":{"s":[30,52.004,2.472]},"ما نزل فيه، وما قيل فيه":{"s":[30,54.826,3.552]},"﴿إنما وليكم الله ورسوله والذين آمنوا الذين يقيمون الصلاة ويؤتون الزكاة وهم راكعون﴾":{"q":"5-55","o":"qs"},"المائدة ، نزلت فيه حين تصدق بخاتمه وهو راكع: سئل السائل «على أي حال أعطاك؟ قال: كان راكعا».":{"s":[30,58.728,11.184]},"﴿ويطعمون الطعام على حبه مسكينا ويتيما وأسيرا ۝ إنما نطعمكم لوجه الله لا نريد منكم جزاء ولا شكورا﴾":{"q":"76-8","o":"qs"},"الإنسان –، نذر علي وفاطمة صوم ثلاثة أيام شكرا لعافية الحسنين، فأعطوا إفطارهم في الليالي الثلاث لمسكين ويتيم وأسير.":{"s":[30,70.262,10.848]},"الأحزاب ، آية التطهير، نزلت في أصحاب الكساء الخمسة.":{"s":[30,81.46,5.112]},"«أنا مدينة العلم وعلي بابها»":{"s":[30,86.922,3.624]},"«علي مع الحق والحق معه، لا يفترقان حتى يردا علي الحوض»":{"s":[31,0.0,6.312]},"«يا علي، لا يبغضك مؤمن، ولا يحبك منافق»":{"s":[31,6.662,5.424]},"«سدوا الأبواب الشارعة في المسجد إلا باب علي»":{"s":[31,12.436,4.488]},"«لو كشف الغطاء ما ازددت يقينا»":{"s":[31,17.274,3.6]},"«علي قسيم الجنة والنار»":{"s":[31,21.224,3.288]},"«اللهم إني أسألك برحمتك التي وسعت كل شيء، وبقوتك التي قهرت بها كل شيء، وخضع لها كل شيء، وذل لها كل شيء»":{"s":[31,24.862,11.784]},"دعاء كميل: «روي أن كميل بن زياد النخعي رأى أمير المؤمنين عليه السلام ساجدا يدعو بهذا الدعاء في ليلة النصف من شعبان».":{"s":[31,36.996,10.872]},"اللهم صل على محمد وآل محمد":{"s":[31,48.218,4.08]},"من أعلامهمرة في حياة النبي، ومرة بعدهالمدينة، ثم بابل":{"s":[31,52.648,7.824]},"رد الشمس":{"s":[31,60.822,2.088]},"«كان ذات يوم في منزله، وعلي عليه السلام بين يديه، إذ جاءه جبرئيل عليه السلام يناجيه عن الله سبحانه، فلما تغشاه الوحي توسد فخذ أمير المؤمنين عليه السلام، فلم يرفع رأسه عنه حتى غابت الشمس»":{"s":[31,63.26,18.984]},"«فسأل أمير المؤمنين الله عز اسمه في رد الشمس، فردت عليه حتى صارت في موضعها من السماء وقت العصر، فصلى أمير المؤمنين عليه السلام صلاة العصر في وقتها ثم غربت»":{"s":[31,82.594,15.48]},"وبعد رسول الله صلى الله عليه وآله: «لما أراد أن يعبر الفرات ببابل، اشتغل كثير من أصحابه بتعبير دوابهم ورحالهم … فلم يفرغ الناس من عبورهم حتى غربت الشمس … سأل الله تعالى رد الشمس عليه، ليجتمع كافة أصحابه على صلاة العصر في وقتها»":{"s":[32,0.0,22.992]},"يذكرها الشيخ المفيد في فصل «مما أظهره الله تعالى من الأعلام الباهرة على يده»: «رجوع الشمس له عليه السلام مرتين: في حياة النبي صلى الله عليه وآله مرة، وبعد وفاته مرة أخرى».":{"s":[32,23.342,16.656]},"«فقالت أسماء: أم والله لقد سمعنا لها عند غروبها صريرا كصرير المنشار في الخشبة»":{"s":[32,40.348,8.28]},"أبناؤه":{"s":[32,48.978,1.872]},"سبعة وعشرون ولدا، ذكرا وأنثى":{"s":[32,51.2,4.44]},"«فأولاد أمير المؤمنين صلوات الله عليه سبعة وعشرون ولدا ذكرا وأنثى».":{"s":[32,55.99,6.912]},"«الشهداء مع أخيهم الحسين … بطف كربلاء»":{"s":[32,63.252,5.016]},"فاطمة البتول، سيدة نساء العالمين":{"s":[32,68.618,4.8]},"الإمام الحسن عليه السلام، الإمام الحسين عليه السلام، زينب الكبرى، زينب الصغرى المكناة أم كلثوم":{"s":[32,73.768,9.888]},"خولة بنت جعفر بن قيس الحنفية":{"s":[32,84.006,4.176]},"محمد المكنى أبا القاسم":{"s":[32,88.532,3.312]},"أم حبيب بنت ربيعة":{"s":[33,0.0,3.12]},"عمر، رقية":{"s":[33,3.47,2.88]},"كانا توأمين":{"s":[33,6.7,2.352]},"أم البنين بنت حزام بن خالد بن دارم":{"s":[33,9.402,4.296]},"العباس، جعفر، عثمان، عبد الله":{"s":[33,14.048,5.28]},"«الشهداء مع أخيهم الحسين بطف كربلاء»":{"s":[33,19.678,4.608]},"ليلى بنت مسعود الدارمية":{"s":[33,24.636,3.528]},"محمد الأصغر المكنى أبا بكر، عبيد الله":{"s":[33,28.514,4.728]},"«الشهيدان مع أخيهما الحسين عليه السلام بالطف»":{"s":[33,33.592,4.968]},"أسماء بنت عميس الخثعمية":{"s":[33,38.91,3.696]},"يحيى":{"s":[33,42.956,1.872]},"أم سعيد بنت عروة بن مسعود الثقفي":{"s":[33,45.178,4.464]},"أم الحسن، رملة":{"s":[33,49.992,2.976]},"لأمهات شتى":{"s":[33,53.318,2.592]},"نفيسة، زينب الصغرى، رقية الصغرى، أم هانئ، أم الكرام، جمانة المكناة أم جعفر، أمامة، أم سلمة، ميمونة، خديجة، فاطمة":{"s":[33,56.26,14.64]},"«وفي الشيعة من يذكر أن فاطمة صلوات الله عليها أسقطت بعد النبي صلى الله عليه وآله ولدا ذكرا كان سماه رسول الله وهو حمل محسنا، فعلى قول هذه الطائفة أولاد أمير المؤمنين عليه السلام ثمانية وعشرون».":{"s":[33,71.25,18.768]},"أصحابه":{"s":[34,0.0,1.872]},"رجال عرفوه فلزموه":{"s":[34,2.222,3.264]},"مالك الأشتر":{"s":[34,5.836,2.424]},"قائده، وواليه على مصر":{"s":[34,8.61,3.456]},"«أما بعد، فقد بعثت إليكم عبدا من عباد الله، لا ينام أيام الخوف، ولا ينكل عن الأعداء ساعات الروع، أشد على الفجار من حريق النار، وهو مالك بن الحارث أخو مذحج»":{"s":[34,12.416,15.696]},"وقال حين جاءه نعيه:":{"s":[34,28.462,2.952]},"«مالك وما مالك! والله لو كان جبلا لكان فندا، ولو كان حجرا لكان صلدا، لا يرتقيه الحافر، ولا يوفي عليه الطائر»":{"s":[34,31.764,12.696]},"عمار بن ياسر":{"s":[34,44.81,2.688]},"استشهد معه في صفين":{"s":[34,47.848,3.24]},"قال له رسول الله صلى الله عليه وآله: «إنك من أهل الجنة، تقتلك الفئة الباغية»":{"s":[34,51.438,8.424]},"وقال علي عليه السلام بعد ذلك بالكوفة:":{"s":[34,60.212,4.584]},"«أين إخواني الذين ركبوا الطريق، ومضوا على الحق؟ أين عمار؟ وأين ابن التيهان؟ وأين ذو الشهادتين؟ وأين نظراؤهم من إخوانهم الذين تعاقدوا على المنية، وأبرد برؤوسهم إلى الفجرة!»":{"s":[34,65.146,20.064]},"كميل بن زياد":{"s":[34,85.56,2.688]},"صاحب الوصية والدعاء":{"s":[34,88.598,3.096]},"«يا كميل، العلم خير من المال: العلم يحرسك وأنت تحرس المال، والمال تنقصه النفقة، والعلم يزكو على الإنفاق»":{"s":[35,0.0,11.4]},"«روي أن كميل بن زياد النخعي رأى أمير المؤمنين عليه السلام ساجدا يدعو بهذا الدعاء في ليلة النصف من شعبان»، فصار يعرف بدعاء كميل.":{"s":[35,11.75,12.12]},"ولما طلبه الحجاج قال له كميل: «ولقد خبرني أمير المؤمنين علي بن أبي طالب عليه السلام أنك قاتلي»، فقتله.":{"s":[35,24.22,10.776]},"ميثم التمار":{"s":[35,35.346,2.496]},"بائع التمر في الكوفة":{"s":[35,38.192,3.096]},"قال له علي عليه السلام ذات يوم: «إنك تؤخذ بعدي فتصلب وتطعن بحربة … وتصلب على باب دار عمرو بن حريث عاشر عشرة، أنت أقصرهم خشبة، وأقربهم من المطهرة، وامض حتى أريك النخلة التي تصلب على جذعها» فأراه إياها":{"s":[35,41.638,20.784]},"وكان ميثم يصلي عندها ويقول: «بوركت من نخلة، لك خلقت ولي غذيت».":{"s":[35,62.772,7.608]},"حجر بن عدي":{"s":[35,70.73,2.424]},"من خاصته":{"s":[35,73.504,1.944]},"قتله معاوية بعد أن أعطاه العهود، فكتب إليه الإمام الحسين عليه السلام:":{"s":[35,75.798,7.704]},"«ألست قاتل حجر بن عدي أخي كندة وأصحابه الصالحين المطيعين العابدين، كانوا ينكرون الظلم، ويستعظمون المنكر والبدع، ويؤثرون حكم الكتاب، ولا يخافون في الله لومة لائم، فقتلتهم ظلما وعدوانا، بعدما كنت أعطيتهم الأيمان المغلظة، والمواثيق المؤكدة»":{"s":[35,83.852,24.048]},"قنبر":{"s":[36,0.0,1.872]},"مولاه":{"s":[36,2.222,1.944]},"اشترى ثوبين، أحدهما بثلاثة دراهم والآخر بدرهمين:":{"s":[36,4.516,6.312]},"«فقال: يا قنبر، خذ الذي بثلاثة. قال: أنت أولى به يا أمير المؤمنين، تصعد المنبر وتخطب الناس. قال: يا قنبر، أنت شاب، ولك شره الشباب، وأنا أستحيي من ربي أن أتفضل عليك، لأني سمعت رسول الله صلى الله عليه وآله يقول: ألبسوهم مما تلبسون، وأطعموهم مما تأكلون»":{"s":[36,11.178,30.0]},"الإمامة من بعده":{"s":[36,41.528,2.544]},"الأئمة الاثنا عشر":{"s":[36,44.422,2.784]},"دفع علي عليه السلام «الكتاب والسلاح» إلى الحسن، وأمره أن يدفعها إلى الحسين، ثم إلى علي بن الحسين، ثم إلى محمد بن علي. و«إن الحسين صلوات الله عليه لما صار إلى العراق استودع أم سلمة رضي الله عنها الكتب والوصية، فلما رجع علي بن الحسين دفعتها إليه».":{"s":[36,47.556,23.952]},"تواريخ الوفاة والأعمار والمراقد في المشهد التالي من الكافي، ج، أبواب مواليد الأئمة عليهم السلام.":{"s":[36,71.858,10.416]},"علي بن أبي طالب":{"s":[36,82.624,2.736]},"أمير المؤمنين":{"s":[36,85.71,2.448]},"مضى رمضان ه، عن ثلاث وستين سنة":{"s":[36,88.508,8.208]},"الغري، النجف":{"s":[37,0.0,2.856]},"الحسن بن علي":{"s":[37,3.206,2.472]},"المجتبى":{"s":[37,6.028,1.992]},"مضى آخر صفر ه، عن سبع وأربعين سنة وأشهر":{"s":[37,8.37,8.04]},"البقيع، المدينة":{"s":[37,16.76,3.288]},"الحسين بن علي":{"s":[37,20.398,2.64]},"سيد الشهداء":{"s":[37,23.388,2.376]},"مضى محرم ه، عن سبع وخمسين سنة وأشهر":{"s":[37,26.114,8.136]},"كربلاء":{"s":[37,34.6,1.944]},"علي بن الحسين":{"s":[37,36.894,2.688]},"زين العابدين، السجاد":{"s":[37,39.932,3.792]},"مضى ه، عن سبع وخمسين سنة":{"s":[37,44.074,5.928]},"محمد بن علي":{"s":[37,50.352,2.544]},"الباقر":{"s":[37,53.246,1.872]},"جعفر بن محمد":{"s":[37,55.468,2.808]},"الصادق":{"s":[37,58.626,1.896]},"مضى شوال ه، عن خمس وستين سنة":{"s":[37,60.872,7.848]},"موسى بن جعفر":{"s":[37,69.07,2.496]},"الكاظم":{"s":[37,71.916,1.872]},"مضى رجب ه، عن أربع أو خمس وخمسين سنة":{"s":[37,74.138,8.928]},"مقابر قريش، بغداد":{"s":[37,83.416,3.624]},"علي بن موسى":{"s":[37,87.39,2.784]},"الرضا":{"s":[38,0.0,1.872]},"مضى صفر ه، عن خمس وخمسين سنة":{"s":[38,2.222,7.104]},"طوس، سناباد":{"s":[38,9.676,2.952]},"الجواد":{"s":[38,12.978,1.968]},"مضى آخر ذي القعدة ه، عن خمس وعشرين سنة":{"s":[38,15.296,7.656]},"مقابر قريش، عند جده موسى":{"s":[38,23.302,4.416]},"علي بن محمد":{"s":[38,28.068,2.712]},"الهادي":{"s":[38,31.13,1.92]},"مضى جمادى الآخرة ه، عن إحدى وأربعين سنة ونصف":{"s":[38,33.4,10.416]},"سر من رأى، في داره":{"s":[38,44.166,3.024]},"العسكري":{"s":[38,47.54,1.944]},"مضى ربيع الأول ه، عن ثمان وعشرين سنة":{"s":[38,49.834,8.232]},"سر من رأى، بجنب أبيه":{"s":[38,58.416,3.312]},"محمد بن الحسن":{"s":[38,62.078,2.688]},"المهدي المنتظر، عجل الله فرجه":{"s":[38,65.116,4.272]},"ولد للنصف من شعبان ه":{"s":[38,69.738,6.576]},"«وله قبل قيامه غيبتان»":{"s":[38,76.664,3.576]},"التسلسل":{"s":[38,80.59,1.968]},"حياته في فصلا":{"s":[38,82.908,3.816]},"خريطة حياته":{"s":[38,87.074,2.424]},"حياتان":{"s":[38,89.848,1.992]},"رسول الله صلى الله عليه وآله، وعلي عليه السلام":{"s":[39,0.0,6.0]},"خطان على مر السنين: أين بدأ كل منهما، وأين اجتمعا، وأين مضى علي وحده بعد رسول الله. مرر ليتحرك الزمن.":{"s":[39,6.35,12.432]},"أربع وعشرون سنة وأشهر «ممنوعا من التصرف على أحكامها»":{"s":[39,19.132,6.456]},"ضرار بن حمزة يصفه، نهج البلاغة، الحكمة":{"s":[39,25.938,7.104]},"فأشهد لقد رأيته في بعض مواقفه وقد أرخى الليل سدوله، وهو قائم في محرابه، قابض على لحيته، يتململ تململ السليم، ويبكي بكاء الحزين، ويقول:":{"s":[39,33.392,15.072]},"يا دنيا يا دنيا إليك عني، أبي تعرضت؟ أم إلي تشوقت؟ لا حان حينك! هيهات! غري غيري، لا حاجة لي فيك، قد طلقتك ثلاثا لا رجعة فيها":{"s":[39,48.814,17.688]},"زيارة أمين الله":{"s":[39,66.852,2.64]},"زاره بها الإمام زين العابدين عليه السلام":{"s":[39,69.842,4.632]},"يرويها ابن قولويه بسنده عن الإمام الرضا، عن أبيه الكاظم، عن أبيه الصادق عليهم السلام: أن علي بن الحسين عليه السلام زار قبره فوقف عليه وبكى وقال:":{"s":[39,74.824,14.448]},"السلام عليك يا أمين الله في أرضه، وحجته على عباده. أشهد أنك جاهدت في الله حق جهاده، وعملت بكتابه، واتبعت سنن نبيه صلى الله عليه وآله وسلم، حتى دعاك الله في جواره، وقبضك باختياره، وألزم أعداءك الحجة في قتلهم إياك، مع ما لك من الحجج البالغة على جميع خلقه.":{"s":[39,89.622,27.312]},"اللهم فاجعل نفسي مطمئنة بقدرك، راضية بقضائك، مولعة بذكرك ودعائك، محبة لصفوة أوليائك، محبوبة في أرضك وسمائك، صابرة على نزول بلائك، شاكرة لفواضل نعمائك، ذاكرة لسوابغ آلائك، مشتاقة إلى فرحة لقائك، متزودة التقوى ليوم جزائك، مستنة بسنن أوليائك، مفارقة لأخلاق أعدائك، مشغولة عن الدنيا بحمدك وثنائك.":{"s":[40,0.0,35.472]},"ثم وضع خده على القبر وقال:":{"s":[40,35.822,3.72]},"اللهم إن قلوب المخبتين إليك والهة، وسبل الراغبين إليك شارعة، وأعلام القاصدين إليك واضحة، وأفئدة العارفين منك فازعة، وأصوات الداعين إليك صاعدة، وأبواب الإجابة لهم مفتحة، ودعوة من ناجاك مستجابة، وتوبة من أناب إليك مقبولة، وعبرة من بكى من خوفك مرحومة، والإعانة لمن استعان بك موجودة، والإغاثة لمن استغاث بك مبذولة، وعداتك لعبادك منجزة، وزلل من استقالك مقالة، وأعمال العاملين لديك محفوظة، وأرزاقك إلى الخلائق من لدنك نازلة، وعوائد المزيد لهم متواترة، وذنوب المستغفرين مغفورة، وحوائج خلقك عندك مقضية، وجوائز السائلين عندك موفورة، وعوائد المزيد إليهم واصلة، وموائد المستطعمين معدة، ومناهل الظماء لديك مترعة.":{"s":[40,39.892,61.92]},"اللهم فاستجب دعائي، واقبل ثنائي، وأعطني رجائي، واجمع بيني وبين أوليائي، بحق محمد وعلي وفاطمة والحسن والحسين عليهم السلام، إنك ولي نعمائي، ومنتهى رجائي، وغاية مناي في منقلبي ومثواي. أنت إلهي وسيدي ومولاي، اغفر لأوليائنا، وكف عنا أعداءنا، واشغلهم عن أذانا، وأظهر كلمة الحق واجعلها العليا، وأدحض كلمة الباطل واجعلها السفلى، إنك على كل شيء قدير.":{"s":[41,0.0,37.392]},"السلام عليك يا أمير المؤمنين ورحمة الله وبركاته":{"s":[41,37.742,5.544]},"المصادر":{"s":[41,43.636,2.04]},"من كتب الإمامية وحدها":{"s":[41,46.026,3.288]},"نهج البلاغةجمع الشريف الرضي (ت ه)، والترقيم وفق طبعة صبحي الصالح":{"s":[41,49.664,10.512]},"الإرشاد في معرفة حجج الله على العبادالشيخ المفيد (ت ه)":{"s":[41,60.526,10.248]},"الكافيثقة الإسلام الكليني (ت ه)":{"s":[41,71.124,8.016]},"الأماليالشيخ الصدوق (ت ه)":{"s":[41,79.49,7.704]},"الأمالي، ومصباح المتهجدشيخ الطائفة الطوسي (ت ه)":{"s":[41,87.544,9.552]},"الأمالي، والجمل والنصرةالشيخ المفيد (ت ه)":{"s":[42,0.0,9.144]},"الخصال، ومعاني الأخبارالشيخ الصدوق (ت ه)":{"s":[42,9.494,9.576]},"وقعة صفيننصر بن مزاحم المنقري (ت ه)":{"s":[42,19.42,8.784]},"عوالي اللآليابن أبي جمهور الأحسائي":{"s":[42,28.554,4.752]},"غرر الحكم ودرر الكلمعبد الواحد الآمدي":{"s":[42,33.656,5.16]},"بحار الأنوارالعلامة المجلسي (ت ه)":{"s":[42,39.166,7.848]},"كامل الزياراتابن قولويه (ت ه)":{"s":[42,47.364,8.016]},"كتاب سليم بن قيسسليم بن قيس الهلالي":{"s":[42,55.73,5.256]},"الاحتجاجأبو منصور الطبرسي":{"s":[42,61.336,4.152]},"الغاراتإبراهيم بن محمد الثقفي (ت ه)":{"s":[42,65.838,8.544]},"قرب الإسنادعبد الله بن جعفر الحميري، عنه وسائل الشيعة":{"s":[42,74.732,7.128]},"الأنوار العلويةالشيخ جعفر النقدي (معاصر)":{"s":[42,82.21,5.88]},"نصوص القرآن الكريم بالرسم الإملائي. وكل نص منسوب إلى نهج البلاغة روجع على طبعة صبحي الصالح، وكل حديث روجع على الكتاب المذكور بجانبه. الصفحة عمل محبة غير رسمي، والرسوم فيها لا تصور أحدا من النبي وأهل بيته، بل تجعلهم نورا.":{"s":[42,88.44,23.856]},"الحسن «ولد بالمدينة ليلة النصف من شهر رمضان سنة ثلاث من الهجرة»، والحسين «لخمس ليال خلون من شعبان سنة أربع».":{"s":[43,0.0,10.656]},"وزينب في الكوفة بعد كربلاء: «الحمد لله والصلاة على أبي رسول الله، أما بعد يا أهل الكوفة، ويا أهل الختل والخذل…»":{"s":[43,11.006,11.256]},"يوم الجمل: «وأعطى الراية محمد بن الحنفية ابنه».":{"s":[43,22.612,5.232]},"يوم كربلاء: «وأعطى رايته العباس أخاه».":{"s":[43,28.194,4.944]},"وقال العباس لإخوته: «يا بني أمي، تقدموا حتى أراكم قد نصحتم لله ولرسوله».":{"s":[43,33.488,8.208]},"«فإنه دفن في موضع مقتله على المسناة بطريق الغاضرية، وقبره ظاهر».":{"s":[43,42.046,7.44]}},"q":{"33-33a":["basit","minshawi"],"5-3a":["basit","minshawi"],"5-55":["basit","minshawi","parhizgar"],"26-214":["basit","minshawi","parhizgar"],"3-61":["basit","minshawi","parhizgar"],"76-8":["basit","minshawi","parhizgar"],"2-207":["basit","minshawi","parhizgar"],"17-81":["basit","minshawi","parhizgar"],"5-67a":["basit","minshawi"],"17-81a":["basit","minshawi"]}}